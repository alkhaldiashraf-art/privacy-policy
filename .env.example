# Copy this file to .env and fill in real values.
# Never commit the real .env file.

APP_NAME=SIUGOALS
APP_ENV=production
APP_URL=https://example.com
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siugoals
DB_USERNAME=siugoals_user
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=siugoals_session
SESSION_LIFETIME_MINUTES=120
SESSION_SECURE_COOKIE=true

# Comma-separated list of IPs allowed to set X-Forwarded-For (reverse proxies you control).
# Leave empty on Hostinger shared hosting (no trusted proxy in front of PHP).
TRUSTED_PROXIES=

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_SIGNUP_MAX=5
RATE_LIMIT_SIGNUP_WINDOW_SECONDS=3600

# Optional. When set, the URL/upload scanner calls the real Anthropic API to
# write AI-generated fix prompts for each finding. When left blank, the
# scanner still runs (findings are always real), but fix prompts fall back
# to a clearly-labelled template instead of an AI-written one.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
