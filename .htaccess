# This file only matters if the web server's document root is mistakenly
# pointed at the repository root instead of /public. Deny everything so
# application source, config and storage are never served directly.
# The correct Hostinger setup points the domain's document root at /public.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
