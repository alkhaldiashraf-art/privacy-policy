Options -Indexes
RewriteEngine On

# SIUGOALS cross-origin SDK modules — force through PHP so module CORS headers are always present.
RewriteRule ^sdk/(launchkit|runtime)\.js$ index.php [QSA,L]
<IfModule mod_headers.c>
  <FilesMatch "^(launchkit|runtime)\.js$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cross-Origin-Resource-Policy "cross-origin"
  </FilesMatch>
</IfModule>
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
<FilesMatch "(^\.env|\.sql$|\.log$|composer\.(json|lock)$)">
  Require all denied
</FilesMatch>
